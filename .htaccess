<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep Laravel internals and secrets off the web when the project root is public_html.
    RewriteRule ^(?:\.env|\.git|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.js)$ - [F,L]
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor)(?:/|$) - [F,L]

    # Use HTTPS once the cPanel certificate is active.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Laravel's front controller and public assets live in /public.
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

Options -Indexes
